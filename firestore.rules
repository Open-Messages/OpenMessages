rules_version = '2';

// OTP sync: each signed-in user can only touch their own documents. Records are ciphertext
// produced on the phone; the server can't read them. See docs/otp-sync.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /otps/{otpId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'createdAt', 'expiresAt'])
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
          && request.resource.data.ct is string && request.resource.data.ct.size() <= 8192
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp;
        allow update: if false;
      }
    }
  }
}
